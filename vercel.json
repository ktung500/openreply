{
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/refresh-tokens",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/attach-next-reel",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/snapshot-followers",
      "schedule": "0 7 * * *"
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run db:generate"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
